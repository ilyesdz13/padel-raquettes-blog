# Ton identifiant Amazon Associates (ex: montag-21).
# Tant que cette variable n'est pas définie avec un vrai tag, les boutons "Voir le prix"
# redirigent vers une recherche Amazon générique (non affiliée) au lieu d'un lien /dp/ASIN.
NEXT_PUBLIC_AMAZON_TAG=TAG-A-CONFIGURER

# URL publique du site, utilisée pour le sitemap, les métadonnées OG et le JSON-LD.
NEXT_PUBLIC_SITE_URL=https://padel-raquettes-blog.vercel.app
